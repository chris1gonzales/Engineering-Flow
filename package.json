{
  "name": "bas-schematics-graphics-flow",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "Shared tracker for BAS controller schematics, submittals and station graphics (Firebase + Netlify).",
  "scripts": {
    "build": "esbuild src/firebase-entry.js --bundle --format=esm --platform=browser --minify --outfile=public/vendor/firebase.js",
    "test": "node test/notify.test.mjs && node test/checklist.test.mjs",
    "rules": "node scripts/gen-rules.mjs"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "firebase-admin": "14.4.0"
  },
  "devDependencies": {
    "esbuild": "0.24.2"
  }
}
